{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.7/.schema/devbox.schema.json",
  "packages": [
    "php@8.5",
    "php85Extensions.xdebug@latest",
    "lefthook@latest"
  ],
  "env": {
    "XDEBUG_MODE": "off"
  },
  "shell": {
    "init_hook": [
      "lefthook install"
    ],
    "scripts": {
      "format": [
        "composer format"
      ],
      "test": [
        "composer test"
      ],
      "coverage": [
        "XDEBUG_MODE=coverage phpunit --testsuite=tests --coverage-clover=build/coverage/clover.xml --coverage-html=build/coverage/html"
      ],
      "check": [
        "composer rector",
        "composer phpstan"
      ],
      "docgen": [
        "docker run --rm -v \"$(pwd):/data\" phpdoc/phpdoc:3 --config=/data/phpdoc.xml"
      ],
      "depcheck": [
        "composer depcheck"
      ]
    }
  }
}

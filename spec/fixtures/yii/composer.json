{
    "name": "zitadel/zitadel-php-fixture-yii",
    "description": "Yii 3 fixture app for Zitadel PHP SDK integration specs",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "yiisoft/di": "^1.0",
        "nyholm/psr7": "^1.0",
        "nyholm/psr7-server": "^1.0",
        "vlucas/phpdotenv": "^5.6",
        "zitadel/zitadel-php": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {},
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

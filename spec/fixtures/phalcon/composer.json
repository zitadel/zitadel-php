{
    "name": "zitadel/zitadel-php-fixture-phalcon",
    "description": "Phalcon fixture app for Zitadel PHP SDK integration specs",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "phalcon/phalcon": "v6.0.x-dev",
        "vlucas/phpdotenv": "^5.6",
        "zitadel/zitadel-php": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

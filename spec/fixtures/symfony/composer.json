{
    "name": "zitadel/zitadel-php-fixture-symfony",
    "description": "Symfony fixture app for Zitadel PHP SDK integration specs",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "symfony/framework-bundle": "^7.0",
        "symfony/runtime": "^7.0",
        "zitadel/zitadel-php": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {"symlink": true}
        }
    ],
    "autoload": {
        "psr-4": {"App\\": "src/"}
    },
    "config": {
        "platform": {"php": "8.3.0"},
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    }
}

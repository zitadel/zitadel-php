{
    "name": "zitadel/zitadel-php-fixture-symfony",
    "description": "Symfony fixture app for Zitadel PHP SDK integration specs",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "symfony/dotenv": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/string": "^8.0",
        "zitadel/zitadel-php": "*@dev",
        "symfony/yaml": "^8.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

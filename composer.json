{
    "name": "zitadel/sdk",
    "description": "Official Zitadel PKCE authentication middleware for PHP. Supports Laravel, Symfony, Yii, CodeIgniter 4, Slim 4, Mezzio, and Phalcon.",
    "keywords": ["auth", "oidc", "pkce", "middleware", "zitadel", "zitadel-sdk"],
    "homepage": "https://github.com/zitadel/zitadel-php",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Zitadel",
            "homepage": "https://zitadel.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "testcontainers/testcontainers": "^1.0",
        "playwright-php/playwright": "^1.2",
        "vlucas/phpdotenv": "^5.6",
        "rector/rector": "^2.0",
        "phpstan/phpstan": "^2.1",
        "icanhazstring/composer-unused": "^0.9.3",
        "nyholm/psr7": "^1.0",
        "mridang/phpunit-reporters": "^1.0",
        "symfony/http-client": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Zitadel\\Sdk\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zitadel\\Sdk\\Test\\": "test/",
            "Zitadel\\Sdk\\Spec\\": "spec/"
        }
    },
    "support": {
        "email": "support@zitadel.com",
        "issues": "https://github.com/zitadel/zitadel-php/issues",
        "source": "https://github.com/zitadel/zitadel-php",
        "security": "https://github.com/zitadel/zitadel-php/security",
        "chat": "https://discord.com/servers/zitadel-927474939156643850"
    },
    "scripts": {
        "pre-test": "rm -f build/coverage/clover.xml",
        "test": "phpunit --testsuite=tests",
        "spec": "phpunit --testsuite=specs --log-junit=build/reports/junit-spec.xml",
        "rector": "rector process",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "format": "php-cs-fixer fix",
        "depcheck": "composer-unused"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        },
        "process-timeout": 0
    },
    "suggest": {
        "laravel/framework": "^11.0|^12.0|^13.0 — enables ZitadelServiceProvider auto-discovery",
        "symfony/http-kernel": "^7.0|^8.0 — enables ZitadelBundle",
        "yiisoft/router": "^3.0|^4.0 — enables Yii bridge with AllowAnonymous support",
        "codeigniter4/framework": "^4.0 — enables ZitadelFilter",
        "phalcon/phalcon": "v6.0.x-dev — enables Phalcon MVC/Micro plugins",
        "slim/slim": "^4.0 — use core ZitadelMiddleware directly via $app->add()",
        "mezzio/mezzio": "^3.0 — use core ZitadelMiddleware directly; RouteResult attribute enables AllowAnonymous"
    },
    "extra": {
        "laravel": {
            "providers": ["Zitadel\\Sdk\\Bridge\\Laravel\\ZitadelServiceProvider"]
        }
    }
}
